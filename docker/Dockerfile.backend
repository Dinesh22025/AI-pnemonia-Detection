# Stage 1: Build Python Dependencies
FROM python:3.11-slim as builder

WORKDIR /app

# Install build dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install dependencies
# Install stable packages first (fast, reliable), then the heavy ML packages
# separately in a retry loop to handle the large TensorFlow wheel on unstable
# networks (the download is ~570MB and can be corrupted mid-transfer).
COPY backend/requirements.txt backend/requirements-ml.txt ./
RUN pip install --user --no-cache-dir --timeout 300 --retries 10 -r requirements.txt

# Retry loop for the heavy ML packages (TensorFlow wheel is ~570MB and can be
# corrupted mid-transfer on unstable connections). Each retry re-downloads only
# the failed/fresh packages.
RUN for i in 1 2 3 4 5; do \
        pip install --user --no-cache-dir --timeout 600 --retries 20 -r requirements-ml.txt && break; \
        echo "ML dependency install failed (attempt $i/5), retrying..."; \
    done

# Stage 2: Production Image
FROM python:3.11-slim

WORKDIR /app

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    libpq-dev \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Copy Python dependencies from builder
COPY --from=builder /root/.local /root/.local

# Copy application code
COPY backend/ .
COPY deep_learning/ /deep_learning/

# Make sure scripts are in PATH
ENV PATH=/root/.local/bin:$PATH
ENV PYTHONPATH=/app

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

# Run with gunicorn for production
CMD ["gunicorn", "main:app", "--worker-class", "uvicorn.workers.UvicornWorker", "--bind", "0.0.0.0:8000", "--workers", "4", "--timeout", "120", "--access-logfile", "-"]
